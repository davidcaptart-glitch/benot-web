# ──────────────────────────────────────────────
#  BENOT Web — Variables de entorno
#  Copia este fichero como .env en el servidor y rellénalo.
#  NUNCA subas .env al repositorio.
# ──────────────────────────────────────────────

# ── URL pública del sitio ──
NEXT_PUBLIC_BASE_URL=https://benot.store

# ── Stripe ──
# Panel → Developers → API keys
STRIPE_SECRET_KEY=sk_live_...
# Panel → Developers → Webhooks → tu endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Precios (en céntimos de euro) ──
PRICE_PERSONALIZADA=4290    # 42,90 €
PRICE_RUNNING=3790          # 37,90 €
PRICE_YOTEEMPUJO=2790       # 27,90 €

# ── Telegram — notificación tras cada pedido ──
# Token del bot (BotFather)
TELEGRAM_BOT_TOKEN=...
# Chat ID del administrador donde llegan las notificaciones.
# Para obtenerlo: envía un mensaje a @userinfobot o a tu bot y llama a
#   https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_ADMIN_CHAT_ID=...
