# ─────────────────────────────────────────────────────────────────
# BENOT – Environment variables example
# Copy this file to .env and fill in the real values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────────────────────────
# docker-compose: postgresql://benot:${DB_PASSWORD}@db:5432/benot  (set automatically)
# Local dev: postgresql://benot:changeme@localhost:5432/benot
# Production: use a managed DB URL (Supabase, Neon, RDS, etc.)
DATABASE_URL=postgresql://benot:changeme@localhost:5432/benot

# Optional: override the data directory for frozen assets + PDFs
# DATA_DIR=/app/data

# ── Authentication ────────────────────────────────────────────────
# Used to sign JWT session tokens. Must be a long random string (32+ chars).
# Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret-string

# Admin credentials — used for initial setup and seed.
# After running npm run db:seed, the admin user is stored in the DB with bcrypt hash.
ADMIN_EMAIL=admin@benot.store
ADMIN_PASSWORD=change-this-password

# Legacy API key for REST endpoints (x-admin-secret header)
ADMIN_SECRET=replace-with-another-secret

# ── Stripe ────────────────────────────────────────────────────────
# Panel → Developers → API keys
STRIPE_SECRET_KEY=sk_live_...
# Panel → Developers → Webhooks → tu endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...

# ── Email (SMTP) ──────────────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
EMAIL_FROM="BENOT <noreply@benot.store>"

# ── Telegram notifications (optional) ────────────────────────────
# Token del bot (BotFather)
TELEGRAM_BOT_TOKEN=123456789:ABCdef...
# Chat ID del administrador donde llegan las notificaciones.
TELEGRAM_ADMIN_CHAT_ID=-1001234567890

# ── Provider emails ───────────────────────────────────────────────
PROVIDER_A_EMAIL=proveedor_premium@proveedor.com
PROVIDER_B_EMAIL=proveedor_running@proveedor.com
PROVIDER_C_EMAIL=proveedor_solidaria@proveedor.com

# ── App URL ───────────────────────────────────────────────────────
NEXT_PUBLIC_BASE_URL=https://benot.store

# ── Docker Compose ────────────────────────────────────────────────
# DB_PASSWORD is the PostgreSQL password used in docker-compose.
# The web container auto-receives DATABASE_URL from the environment block.
DB_PASSWORD=changeme

# ── Precios legacy (en céntimos) ─────────────────────────────────
# Estos valores ya NO se usan como fuente de precios — se configuran
# desde el panel admin /admin/products y se persisten en PostgreSQL.
# Mantenidos aquí solo como referencia histórica.
# PRICE_PERSONALIZADA=4290
# PRICE_RUNNING=3790
# PRICE_YOTEEMPUJO=2790
